<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VedaMatrix.Views.PauseDialog"
        Title="Pause hinzufügen"
        Width="360" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FFFFFF"
        FontFamily="Inter, Segoe UI, Helvetica, Arial, sans-serif"
        FontSize="13">

  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="PAUSE DEFINIEREN" FontWeight="Bold" FontSize="13" LetterSpacing="1" Margin="0,0,0,16"/>

    <Grid Grid.Row="1" ColumnDefinitions="120,*" Margin="0,0,0,10">
      <TextBlock Text="Beginn" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" x:Name="StartBox" Text="12:00" Watermark="HH:mm"/>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="120,*" Margin="0,0,0,10">
      <TextBlock Text="Ende" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" x:Name="EndBox" Text="12:30" Watermark="HH:mm"/>
    </Grid>

    <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#AA0000" TextWrapping="Wrap" FontSize="12"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,12,0,0">
      <Button Content="Abbrechen" Classes="secondary" Click="OnCancel"/>
      <Button Content="Hinzufügen" Click="OnConfirm"/>
    </StackPanel>
  </Grid>
</Window>
