<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VedaMatrix.ViewModels"
        x:Class="VedaMatrix.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VEDA Matrix"
        Width="1100" Height="840"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Inter, Segoe UI, Helvetica, Arial, sans-serif"
        FontSize="13">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Grid Margin="20" RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="VEDA MATRIX" FontSize="22" FontWeight="Bold" Foreground="#111111"/>
      <TextBlock Text="Buchungsvorgänge im Veda Horizon – Vorlagen &amp; Entscheidungsmatrix" Foreground="#555555"/>
    </StackPanel>

    <!-- Main content: templates | details+times | results -->
    <Grid Grid.Row="1" ColumnDefinitions="280,300,*" ColumnSpacing="16">

      <!-- ── Column 1: Template list ── -->
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="VORLAGEN" FontWeight="Bold" FontSize="12" LetterSpacing="1" Margin="0,0,0,10"/>
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding ProcedureTemplates}"
                   SelectedItem="{Binding SelectedTemplate}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
                  <TextBlock Text="{Binding Description}" Foreground="#666666" TextWrapping="Wrap" FontSize="11"/>
                  <TextBlock Text="{Binding Category}" Foreground="#999999" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- ── Column 2: Selection details + times ── -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">

          <Border Classes="card">
            <StackPanel Spacing="6">
              <TextBlock Text="GEWÄHLTE PROZEDUR" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
              <TextBlock Text="{Binding SelectedProcedure.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedProcedure.Description}" Foreground="#555555" TextWrapping="Wrap" FontSize="12"/>
              <TextBlock Text="{Binding AttentionNote}" Foreground="#111111" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="PARAMETER (optional anpassen)" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>

              <TextBlock Text="Arbeitsbeginn Ort" FontSize="11" Foreground="#555555"/>
              <ComboBox ItemsSource="{Binding OrtBeginnOptions}" SelectedItem="{Binding SelectedOrtBeginn}" HorizontalAlignment="Stretch"/>

              <TextBlock Text="Pause" FontSize="11" Foreground="#555555"/>
              <ComboBox ItemsSource="{Binding PauseOptions}" SelectedItem="{Binding SelectedPause}" HorizontalAlignment="Stretch"/>

              <TextBlock Text="Dienstgang" FontSize="11" Foreground="#555555"/>
              <ComboBox ItemsSource="{Binding DienstgangOptions}" SelectedItem="{Binding SelectedDienstgang}" HorizontalAlignment="Stretch"/>

              <StackPanel IsVisible="{Binding ShowDienstgangDetails}" Spacing="10">
                <TextBlock Text="Dienstgang Ende-Typ" FontSize="11" Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding DienstgangEndeTypOptions}" SelectedItem="{Binding SelectedDienstgangEndeTyp}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowDienstgangOrt}" Spacing="10">
                <TextBlock Text="Dienstgang Ort" FontSize="11" Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding DienstgangOrtOptions}" SelectedItem="{Binding SelectedDienstgangOrt}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowOrtEnde}" Spacing="10">
                <TextBlock Text="Arbeitsende Ort" FontSize="11" Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding OrtEndeOptions}" SelectedItem="{Binding SelectedOrtEnde}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowMitarbeiterTyp}" Spacing="10">
                <TextBlock Text="Mitarbeiter-Typ" FontSize="11" Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding MitarbeiterTypOptions}" SelectedItem="{Binding SelectedMitarbeiterTyp}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowZusatzMobil}" Spacing="10">
                <TextBlock Text="Zusätzliches mobiles Arbeiten später" FontSize="11" Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding ZusatzMobilOptions}" SelectedItem="{Binding SelectedZusatzMobil}" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding ShowDienstreise}" Spacing="10">
                <TextBlock Text="Dienstreiseantrag erforderlich?" FontSize="11" Foreground="#555555"/>
                <ComboBox ItemsSource="{Binding DienstreiseOptions}" SelectedItem="{Binding SelectedDienstreise}" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="ZEITEN" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
              <ItemsControl ItemsSource="{Binding TimeInputs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,100" Margin="0,0,0,6">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
                      <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="HH:mm"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="#DDDDDD" Margin="0,6"/>

              <Grid ColumnDefinitions="*,100">
                <TextBlock Text="Sollarbeitszeit" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding SollzeitText}" Watermark="07:48"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ── Column 3: Results ── -->
      <Border Grid.Column="2" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Text="BUCHUNGSSEQUENZ" FontWeight="Bold" FontSize="12" LetterSpacing="1" Margin="0,0,0,12"/>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BookingResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="28,160,70,*">
                      <TextBlock Text="{Binding Nummer}" FontWeight="Bold" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Text="{Binding Aktion}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="2" Text="{Binding Zeit}" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="3" Text="{Binding Kommentar}" Foreground="#555555" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Top"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="ZEITÜBERSICHT" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
              <Grid ColumnDefinitions="120,80,120,80">
                <TextBlock Text="Gearbeitet" Foreground="#555555"/>
                <TextBlock Grid.Column="1" Text="{Binding SummaryGearbeitet}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Sollzeit" Foreground="#555555"/>
                <TextBlock Grid.Column="3" Text="{Binding SummarySollzeit}" FontWeight="SemiBold"/>
              </Grid>
              <Grid ColumnDefinitions="120,80">
                <TextBlock Text="Differenz" Foreground="#555555"/>
                <TextBlock Grid.Column="1" Text="{Binding SummaryDifferenz}" FontWeight="SemiBold"/>
              </Grid>
              <TextBlock Text="{Binding SummaryWarning}"
                         IsVisible="{Binding ShowSummaryWarning}"
                         FontWeight="Bold"
                         Foreground="#111111"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#555555" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0" HorizontalAlignment="Right">
      <Button Content="Zurücksetzen" Command="{Binding ResetCommand}" Background="#FFFFFF" Foreground="#111111" BorderBrush="#111111"/>
      <Button Content="Buchungen generieren" Command="{Binding GenerateCommand}"/>
    </StackPanel>
  </Grid>
</Window>
